# Fal.ai API key — get yours at https://fal.ai/dashboard/keys
FAL_API_KEY=fal_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Access tokens. Generate strong random values, e.g.: openssl rand -hex 32
#
# Header token (Authorization: Bearer <token>) — Claude Code, scripts.
# One per server (tokenEnv in servers/registry.ts); falls back to MCP_BEARER_TOKEN.
MCP_TOKEN_FAL=
MCP_BEARER_TOKEN=your_strong_secret_token_here

# URL token (?token=<token>) — only for claude.ai connectors, which can't send
# headers. Must be different from the header token. No fallback: if unset,
# ?token= is disabled for that server.
MCP_URL_TOKEN_FAL=

# If no token is configured at all, requests are rejected.
# Set MCP_ALLOW_OPEN=true only for local testing.
# MCP_ALLOW_OPEN=true
