{
  "rewrites": [
    {
      "source": "/fal-ia/mcp",
      "destination": "/api/fal-ia/mcp"
    }
  ],
  "functions": {
    "api/fal-ia/mcp.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/fal-ia/mcp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache"
        }
      ]
    }
  ]
}
